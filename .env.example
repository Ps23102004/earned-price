# Earned Price — environment. Copy to .env and fill in. Never commit .env.
# Server refuses to start unless PAYPAL_ENV is exactly "sandbox". No live PayPal, ever.

# --- PayPal sandbox REST app (developer.paypal.com → Apps & Credentials → Sandbox) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Same value as PAYPAL_CLIENT_ID; the JS SDK needs it in the browser (public by design).
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- Sandbox buyer shown to judges in judge mode (sandbox Personal account; not a secret) ---
JUDGE_BUYER_EMAIL=
JUDGE_BUYER_PASSWORD=

# --- GitHub OAuth App (one app, callbacks: http://127.0.0.1:3000/api/auth/github/callback and https://<render-host>/api/auth/github/callback) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Fine-grained personal access token with NO repository/account permissions selected (public read is implicit). Expiry after Jan 2027.
GITHUB_SERVER_TOKEN=

# --- Anthropic (runtime rule compiler + loophole proposer; the only paid service, cents per call) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# --- Database: Neon free. Pooled URL for runtime, direct URL for migrations. ---
DATABASE_URL=
DATABASE_URL_DIRECT=

# --- App ---
# Local: http://127.0.0.1:3000 (GitHub recommends 127.0.0.1 over localhost). Prod: https://<render-host>
APP_URL=http://127.0.0.1:3000
# openssl rand -hex 32  (each)
SESSION_SECRET=
LICENSE_HMAC_SECRET=
# 1 = show sandbox buyer credentials, how-it-works strip, demo reset and tamper controls (the demo runs with this on)
JUDGE_MODE=1
